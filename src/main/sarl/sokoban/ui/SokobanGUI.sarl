import framework.math.Point2i
import framework.util.Resources
import sokoban.environment.^agent.Controller
import sokoban.environment.^agent.EnvironmentEvent
import sokoban.environment.^agent.EnvironmentListener
import sokoban.environment.^agent.Player
import sokoban.environment.maze.Direction
import sokoban.environment.maze.GhostBody
import sokoban.environment.maze.sokobanBody
import sokoban.environment.maze.sokobanObject
import sokoban.environment.maze.PillObject
import sokoban.environment.maze.WallObject
import java.awt.BorderLayout
import java.awt.Color
import java.awt.Dimension
import java.awt.Graphics
import java.awt.Graphics2D
import java.awt.^event.KeyEvent
import java.awt.^event.KeyListener
import java.awt.RenderingHints
import java.lang.Math
import java.util.Map
import java.util.concurrent.atomic.AtomicBoolean
import java.util.concurrent.atomic.AtomicInteger
import javax.imageio.ImageIO
import javax.swing.BoxLayout
import javax.swing.ImageIcon
import javax.swing.JButton
import javax.swing.JFrame
import javax.swing.JOptionPane
import javax.swing.JPanel
import javax.swing.JScrollPane

/** 
 * Swing UI for the sokoban game. 
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
class sokobanGUI extends JFrame implements KeyListener, EnvironmentListener {

		/** Width in pixels of a cell.
		 */
	public static val CELL_WIDTH = 20

	/** Height in pixels of a cell.
	 */
	public static val CELL_HEIGHT = 20

	/** Demi-width in pixels of a cell.
	 */
	public static val DEMI_CELL_WIDTH = CELL_WIDTH / 2

	/** Demi-height in pixels of a cell.
	 */
	public static val DEMI_CELL_HEIGHT = CELL_HEIGHT / 2

	val isInit = new AtomicBoolean

	val gridPanel : GridPanel

	val startButton : JButton

	val waitingDuration : long

	var player : Player

	var controller : Controller 

	/**
	 * @param waitingDuration - the duration of sleeping before giving the hand to the simulator back.
	 */
	new (waitingDuration : long) {
		this.waitingDuration = waitingDuration
		this.title = "sokoban Simulator"
		var sokobanIcon = Resources::getResource(typeof(sokobanGUI), "sokoban.png")
		this.iconImage = ImageIO::read(sokobanIcon)
		var iconURL = Resources::getResource(this.class, "play.png")
		this.startButton = new JButton(new ImageIcon(iconURL))
		this.startButton.toolTipText = "Start simulation"
		this.startButton.enabled = false
		this.startButton.addActionListener [
			var ctrl = sokobanGUI.this.controller
			if (ctrl !== null && !ctrl.started) {
				sokobanGUI.this.startButton.enabled = false
				ctrl.startSimulation
			}
		]
		var topPanel = new JPanel
		topPanel.layout = new BoxLayout(topPanel, BoxLayout::X_AXIS)
		topPanel.add(this.startButton)
		this.gridPanel = new GridPanel
		this.gridPanel.focusable = true
		this.gridPanel.addKeyListener(this)
		var sc = new JScrollPane(this.gridPanel)
		this.contentPane.layout = new BorderLayout
		this.contentPane.add(BorderLayout::NORTH, topPanel)
		this.contentPane.add(BorderLayout::CENTER, sc)
		this.preferredSize = new Dimension(600, 600)
		this.defaultCloseOperation = JFrame::EXIT_ON_CLOSE
		pack
		requestFocus
	}

	def bindPlayer(player : Player) : void {
		synchronized (this) {
			this.player = player
		}
	}

	def unbindPlayer(player : Player) : void {
		synchronized (this) {
			this.player = null
		}
	}

	def bindController(controller : Controller) : void {
		synchronized (this) {
			this.controller = controller
			this.startButton.enabled = !this.controller.started
		}
	}

	def unbindController(controller : Controller) : void {
		synchronized (this) {
			this.startButton.enabled = false
			this.controller = null
		}
	}

	def gameOver : void {
		this.visible = false
		JOptionPane::showMessageDialog(this, "The sokoban is dead!",
				this.title, JOptionPane::INFORMATION_MESSAGE)
		dispose
	}

	@SuppressWarnings("discouraged_reference")
	def environmentChanged(^event : EnvironmentEvent) : void {
		if (!isInit.get) {
			this.isInit.set(true)
			this.gridPanel.preferredSize = new Dimension(CELL_WIDTH * ^event.width, CELL_HEIGHT * ^event.height)
			revalidate
			pack
			this.visible = true
			this.gridPanel.requestFocus
		}
		this.gridPanel.setObjects(^event.time, ^event.objects)
		if (this.waitingDuration > 0) {
			try {
				Thread::sleep(this.waitingDuration)
			} catch (e : InterruptedException) {
				throw new RuntimeException(e)
			}
		}
	}

	def keyPressed(e : KeyEvent) {
		var player : Player
		synchronized (this) {
			player = this.player
		}
		if (player !== null) {
			switch (e.keyCode) {
				case KeyEvent::VK_LEFT:
					player.move(Direction::WEST)
				case KeyEvent::VK_RIGHT:
					player.move(Direction::EAST)
				case KeyEvent::VK_UP:
					player.move(Direction::NORTH)
				case KeyEvent::VK_DOWN:
					player.move(Direction::SOUTH)
			}
		}
	}

	def keyReleased(e : KeyEvent) {
		//
	}

	def keyTyped(e : KeyEvent) {
		//
	}

	/** 
	 * Swing panel that is displaying the environment state.
	 * 
	 * @author $Author: sgalland$
	 * @version $FullVersion$
	 * @mavengroupid $GroupId$
	 * @mavenartifactid $ArtifactId$
	 */
        private static class GridPanel extends JPanel {

                static val FLOOR_BASE = new Color(224, 215, 200)
                static val FLOOR_NOISE1 = new Color(236, 229, 215)
                static val FLOOR_NOISE2 = new Color(210, 200, 184)
                static val WALL_BASE = new Color(125, 117, 103)
                static val WALL_EDGE = new Color(87, 80, 69)
                static val WALL_LIGHT = new Color(160, 151, 136)
                static val CRATE_BASE = new Color(176, 134, 84)
                static val CRATE_EDGE = new Color(111, 80, 42)
                static val CRATE_STRAP = new Color(79, 55, 31)
                static val GOAL_BASE = new Color(171, 206, 187)
                static val GOAL_RING = new Color(39, 110, 88)
                static val SHADOW = new Color(0, 0, 0, 45)
                static val WORKER_BODY = new Color(63, 116, 184)
                static val WORKER_OUTLINE = new Color(26, 48, 76)
                static val WORKER_HELMET = new Color(243, 192, 56)
                static val WORKER_SKIN = new Color(241, 218, 189)
                static val WORKER_STRAP = new Color(226, 238, 250, 140)

                var objects : Map<Point2i, sokobanObject>
                var time = new AtomicInteger

                new {
                        this.background = Color::BLACK
                }

		def setObjects(time : int, objects : Map<Point2i, sokobanObject>) {
			synchronized (this.treeLock) {
				this.time.set(time)
				this.objects = objects
				repaint
			}
		}

		def paint(g : Graphics) {
			super.paint(g)

			var px : int
			var py : int
                        var g2d = g as Graphics2D
                        g2d.setRenderingHint(RenderingHints::KEY_ANTIALIASING, RenderingHints::VALUE_ANTIALIAS_ON)

                        var isEvenTime = (this.time.get % 2) == 0

                        if (this.objects !== null) {
                                for (entry : this.objects.entrySet) {
                                        var pos = entry.key
                                        var obj = entry.value
                                        px = CELL_WIDTH * pos.x
                                        py = CELL_HEIGHT * pos.y
                                        drawFloor(g2d, px, py)
                                        if (obj instanceof WallObject) {
                                                drawWall(g2d, px, py)
                                        } else if (obj instanceof sokobanBody) {
                                                drawWorker(g2d, px, py)
                                        } else if (obj instanceof GhostBody) {
                                                drawCrate(g2d, px, py, isEvenTime)
                                        } else if (obj instanceof PillObject) {
                                                drawGoal(g2d, px, py, obj.superPill || isEvenTime)
                                        }

                                }
                        }
                }

                def drawFloor(g2d : Graphics2D, px : int, py : int) {
                        g2d.color = FLOOR_BASE
                        g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
                        var pad = Math::max(1, CELL_WIDTH / 12)
                        g2d.color = FLOOR_NOISE1
                        g2d.fillRect(px + pad, py + pad, Math::max(1, CELL_WIDTH / 3), Math::max(1, CELL_HEIGHT / 6))
                        g2d.color = FLOOR_NOISE2
                        g2d.fillRect(px + CELL_WIDTH - pad - Math::max(2, CELL_WIDTH / 4),
                                        py + CELL_HEIGHT - pad - Math::max(2, CELL_HEIGHT / 7),
                                        Math::max(2, CELL_WIDTH / 4), Math::max(1, CELL_HEIGHT / 7))
                }

                def drawWall(g2d : Graphics2D, px : int, py : int) {
                        g2d.color = WALL_BASE
                        g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
                        g2d.color = WALL_LIGHT
                        g2d.drawLine(px, py, px + CELL_WIDTH - 1, py)
                        g2d.drawLine(px, py, px, py + CELL_HEIGHT - 1)
                        g2d.color = WALL_EDGE
                        g2d.drawLine(px, py + CELL_HEIGHT - 1, px + CELL_WIDTH - 1, py + CELL_HEIGHT - 1)
                        g2d.drawLine(px + CELL_WIDTH - 1, py, px + CELL_WIDTH - 1, py + CELL_HEIGHT - 1)
                        g2d.color = new Color(0, 0, 0, 35)
                        var half = CELL_HEIGHT / 2
                        var quarter = CELL_WIDTH / 4
                        g2d.drawLine(px, py + half, px + CELL_WIDTH - 1, py + half)
                        g2d.drawLine(px + quarter, py, px + quarter, py + half)
                        g2d.drawLine(px + 2 * quarter, py + half, px + 2 * quarter, py + CELL_HEIGHT - 1)
                        g2d.drawLine(px + 3 * quarter, py, px + 3 * quarter, py + half)
                }

                def drawCrate(g2d : Graphics2D, px : int, py : int, glow : boolean) {
                        g2d.color = SHADOW
                        g2d.fillRoundRect(px + CELL_WIDTH / 10, py + CELL_HEIGHT / 10,
                                        CELL_WIDTH - CELL_WIDTH / 7, CELL_HEIGHT - CELL_HEIGHT / 7, 6, 6)
                        var pad = Math::max(2, CELL_WIDTH / 8)
                        var w = CELL_WIDTH - 2 * pad
                        var h = CELL_HEIGHT - 2 * pad
                        g2d.color = CRATE_BASE
                        g2d.fillRoundRect(px + pad, py + pad, w, h, 8, 8)
                        g2d.color = CRATE_EDGE
                        g2d.drawRoundRect(px + pad, py + pad, w, h, 8, 8)
                        g2d.color = CRATE_STRAP
                        var strap = Math::max(2, CELL_WIDTH / 12)
                        g2d.fillRect(px + pad, py + pad + h / 3, w, strap)
                        g2d.fillRect(px + pad, py + pad + 2 * h / 3, w, strap)
                        if (glow) {
                                g2d.color = new Color(255, 255, 255, 35)
                                g2d.drawLine(px + pad + 3, py + pad + 3, px + pad + w - 3, py + pad + 3)
                        }
                }

                def drawWorker(g2d : Graphics2D, px : int, py : int) {
                        var pad = Math::max(2, CELL_WIDTH / 10)
                        g2d.color = SHADOW
                        g2d.fillOval(px + pad + CELL_WIDTH / 10, py + CELL_HEIGHT - pad - CELL_HEIGHT / 5,
                                        CELL_WIDTH - 2 * pad - CELL_WIDTH / 6, CELL_HEIGHT / 4)
                        var torsoW = CELL_WIDTH - 2 * pad
                        var torsoH = (CELL_HEIGHT * 0.55) as int
                        var torsoX = px + pad
                        var torsoY = py + CELL_HEIGHT - torsoH - pad
                        g2d.color = WORKER_BODY
                        g2d.fillRoundRect(torsoX, torsoY, torsoW, torsoH, pad * 2, pad * 2)
                        g2d.color = WORKER_OUTLINE
                        g2d.drawRoundRect(torsoX, torsoY, torsoW, torsoH, pad * 2, pad * 2)
                        var armW = Math::max(3, CELL_WIDTH / 6)
                        var armH = Math::max(4, CELL_HEIGHT / 3)
                        g2d.color = WORKER_BODY
                        g2d.fillRoundRect(px + pad / 2, torsoY + pad, armW, armH, pad, pad)
                        g2d.fillRoundRect(px + CELL_WIDTH - pad / 2 - armW, torsoY + pad, armW, armH, pad, pad)
                        g2d.color = WORKER_STRAP
                        g2d.fillRect(torsoX + torsoW / 3, torsoY + pad, Math::max(2, torsoW / 6), torsoH - 2 * pad)
                        var headD = (CELL_WIDTH * 0.45) as int
                        var headX = px + (CELL_WIDTH - headD) / 2
                        var headY = torsoY - headD / 2
                        g2d.color = WORKER_SKIN
                        g2d.fillOval(headX, headY, headD, headD)
                        g2d.color = WORKER_OUTLINE
                        g2d.drawOval(headX, headY, headD, headD)
                        var helmetH = Math::max(4, (headD * 0.55) as int)
                        var helmetY = headY - helmetH / 3
                        g2d.color = WORKER_HELMET
                        g2d.fillOval(headX, helmetY, headD, helmetH)
                        g2d.color = WORKER_OUTLINE
                        g2d.drawOval(headX, helmetY, headD, helmetH)
                }

                def drawGoal(g2d : Graphics2D, px : int, py : int, pulse : boolean) {
                        g2d.color = GOAL_BASE
                        g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
                        var ringPad = Math::max(3, CELL_WIDTH / 6)
                        g2d.color = GOAL_RING
                        g2d.drawOval(px + ringPad, py + ringPad, CELL_WIDTH - 2 * ringPad, CELL_HEIGHT - 2 * ringPad)
                        var dotD = Math::max(4, CELL_WIDTH / 4)
                        if (pulse) dotD += 2
                        g2d.fillOval(px + (CELL_WIDTH - dotD) / 2, py + (CELL_HEIGHT - dotD) / 2, dotD, dotD)
                }

        }

}
