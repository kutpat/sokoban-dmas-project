/** 
 * Swing UI for the sokoban game. 
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
class sokobanGUI extends JFrame implements KeyListener, EnvironmentListener {

		/** Width in pixels of a cell.
		 */
	public static val CELL_WIDTH = 20

	/** Height in pixels of a cell.
	 */
	public static val CELL_HEIGHT = 20

	/** Demi-width in pixels of a cell.
	 */
	public static val DEMI_CELL_WIDTH = CELL_WIDTH / 2

	/** Demi-height in pixels of a cell.
	 */
	public static val DEMI_CELL_HEIGHT = CELL_HEIGHT / 2

	val isInit = new AtomicBoolean

	val gridPanel : GridPanel
	
	/** Update planned path for visualization (called by Environment). */
	def updatePlannedPath(boxPosition : Point2i, path : List<Point2i>) {
		this.gridPanel.updatePlannedPath(boxPosition, path)
	}

	val startButton : JButton

	val fastForwardButton : JButton

	val dashboardPanel : DashboardPanel

	var waitingDuration : long
	
	var originalWaitingDuration : long
	
	var isFastForward : boolean

	var controller : Controller

	/** 
	 * @param waitingDuration - the duration of sleeping before giving the hand to the simulator back.
	 */
	new (waitingDuration : long) {
		this.waitingDuration = waitingDuration
		this.originalWaitingDuration = waitingDuration
		this.isFastForward = false
		this.title = "Sokoban Simulator"
		var sokobanIcon = Resources::getResource(typeof(sokobanGUI), "sokoban.png")
		this.iconImage = ImageIO::read(sokobanIcon)
		var playIconURL = Resources::getResource(this.class, "play.png")
		this.dashboardPanel = new DashboardPanel
		this.startButton = new JButton(new ImageIcon(playIconURL))
		this.startButton.toolTipText = "Start simulation"
		this.startButton.enabled = false
		this.startButton.addActionListener [
			var ctrl = sokobanGUI.this.controller
			if (ctrl !== null && !ctrl.started) {
				sokobanGUI.this.startButton.enabled = false
				sokobanGUI.this.dashboardPanel.setAgentCountEnabled(false)
				ctrl.startSimulation
			}
		]
		// Fast Forward button
		this.fastForwardButton = new JButton("⏩ Fast Forward")
		this.fastForwardButton.toolTipText = "Toggle fast forward (speed up simulation)"
		this.fastForwardButton.enabled = false
		this.fastForwardButton.addActionListener [
			sokobanGUI.this.toggleFastForward
		]
		var topPanel = new JPanel
		topPanel.layout = new BoxLayout(topPanel, BoxLayout::X_AXIS)
		topPanel.add(this.startButton)
		topPanel.add(this.fastForwardButton)
		this.gridPanel = new GridPanel
		this.gridPanel.focusable = true
		this.gridPanel.addKeyListener(this)
		var sc = new JScrollPane(this.gridPanel)
		this.contentPane.layout = new BorderLayout
		this.contentPane.add(BorderLayout::NORTH, topPanel)
		this.contentPane.add(BorderLayout::CENTER, sc)
		this.contentPane.add(BorderLayout::SOUTH, this.dashboardPanel)
		this.preferredSize = new Dimension(600, 600)
		this.defaultCloseOperation = JFrame::EXIT_ON_CLOSE
		pack
		requestFocus
	}

	// Player binding removed - all agents are now autonomous
	def bindPlayer(player : Player) : void {
		// No-op: all agents are autonomous (project requirement)
	}

	def unbindPlayer(player : Player) : void {
		// No-op: all agents are autonomous (project requirement)
	}

	def bindController(controller : Controller) : void {
		synchronized (this) {
			this.controller = controller
			this.startButton.enabled = !this.controller.started
			this.fastForwardButton.enabled = true
		}
	}
	
	/** Toggle fast forward mode. */
	def toggleFastForward : void {
		synchronized (this) {
			this.isFastForward = !this.isFastForward
			if (this.isFastForward) {
				// Fast forward: set delay to 0
				this.waitingDuration = 0
				this.fastForwardButton.text = "⏸ Normal Speed"
				this.fastForwardButton.toolTipText = "Return to normal speed"
				System.out.println("[GUI] Fast forward enabled")
			} else {
				// Normal speed: restore original delay
				this.waitingDuration = this.originalWaitingDuration
				this.fastForwardButton.text = "⏩ Fast Forward"
				this.fastForwardButton.toolTipText = "Toggle fast forward (speed up simulation)"
				System.out.println("[GUI] Normal speed restored")
			}
		}
	}

	def unbindController(controller : Controller) : void {
		synchronized (this) {
			this.startButton.enabled = false
			this.controller = null
		}
	}

	def gameOver : void {
		this.visible = false
		// Show win message - all agents reached exits
		// All agents are autonomous (project requirement)
		JOptionPane::showMessageDialog(this, 
			"Simulation Complete!\n\nAll agents have reached the exits.\n\nWin Condition Met!", 
			this.title, 
			JOptionPane::INFORMATION_MESSAGE)
		dispose
	}

	override getAgentCount : int {
		if (this.dashboardPanel !== null) {
			var count = this.dashboardPanel.getAgentCount
			System.out.println("[GUI] Dashboard reports agent count: " + count)
			return count
		}
		System.out.println("[GUI] Dashboard panel is null, returning default: 2")
		return 2  // Default: 2 agents
	}

	@SuppressWarnings("discouraged_reference")
	def environmentChanged(^event : EnvironmentEvent) : void {
		if (!isInit.get) {
			this.isInit.set(true)
			this.gridPanel.preferredSize = new Dimension(CELL_WIDTH * ^event.width, CELL_HEIGHT * ^event.height)
			revalidate
			pack
			this.visible = true
			this.gridPanel.requestFocus
		}
		this.gridPanel.setObjects(^event.time, ^event.objects, ^event.exitPositions)
		
		// Update dashboard statistics
		updateDashboardStats(^event)
		
		if (this.waitingDuration > 0) {
			try {
				Thread::sleep(this.waitingDuration)
			} catch (e : InterruptedException) {
				throw new RuntimeException(e)
			}
		}
	}

	/** Update dashboard statistics from environment event.
	 * 
	 * @param ^event the environment event
	 */
	def updateDashboardStats(^event : EnvironmentEvent) : void {
		// Count boxes and boxes on targets
		var totalBoxes = 0
		var boxesOnTargets = 0
		var totalAgents = 0
		var agentsAtExit = 0
		
		// Get exit positions from event (cell properties, not objects)
		var exitPositions = ^event.exitPositions
		
		// Count boxes and check if they're on targets
		for (entry : ^event.objects.entrySet) {
			var obj = entry.value
			if (obj instanceof BoxObject) {
				totalBoxes++
				// Check if box is on target using isOnTarget flag
				if ((obj as BoxObject).isOnTarget) {
					boxesOnTargets++
				}
			} else if (obj instanceof sokobanBody) {
				totalAgents++
				if (exitPositions.contains(entry.key)) {
					agentsAtExit++
				}
			}
		}
		
		// Update dashboard
		this.dashboardPanel.updateBoxStats(boxesOnTargets, totalBoxes)
		this.dashboardPanel.updateAgentStats(agentsAtExit, totalAgents)
		this.dashboardPanel.updateTimeStats(0, ^event.time)  // Step count not available in event
	}

	def keyPressed(e : KeyEvent) {
		// Keyboard input disabled - all agents are now autonomous (project requirement)
		// Agents make decisions based on perception and communication
		// No central control allowed (project requirement)
	}

	def keyReleased(e : KeyEvent) {
		//
	}

	def keyTyped(e : KeyEvent) {
		//
	}

	/** 
	 * Swing panel that is displaying the environment state.
	 * 
	 * @author $Author: sgalland$
	 * @version $FullVersion$
	 * @mavengroupid $GroupId$
	 * @mavenartifactid $ArtifactId$
	 */
        private static class GridPanel extends JPanel {

		static val FLOOR_BASE = new Color(240, 235, 225)  // Light beige floor
		static val FLOOR_NOISE1 = new Color(250, 245, 235)  // Lighter highlight
		static val FLOOR_NOISE2 = new Color(230, 225, 215)  // Slight shadow
		static val WALL_BASE = new Color(60, 60, 60)  // Dark gray walls
		static val WALL_EDGE = new Color(40, 40, 40)  // Darker edge
		static val WALL_LIGHT = new Color(80, 80, 80)  // Slight highlight
		static val CRATE_BASE = new Color(176, 134, 84)
		static val CRATE_EDGE = new Color(111, 80, 42)
		static val CRATE_STRAP = new Color(79, 55, 31)
		// Darker colors for boxes on target (exit)
		static val CRATE_ON_TARGET_BASE = new Color(100, 70, 40)
		static val CRATE_ON_TARGET_EDGE = new Color(60, 40, 20)
		static val CRATE_ON_TARGET_STRAP = new Color(40, 25, 15)
		// Exit/goal colors - green square tile with border
		static val GOAL_BASE = new Color(76, 175, 80)  // Green base
		static val GOAL_BORDER = new Color(27, 94, 32)  // Dark green border
		static val GOAL_HIGHLIGHT = new Color(129, 199, 132)  // Light green highlight
		static val GOAL_INNER = new Color(56, 142, 60)  // Inner darker green
		static val SHADOW = new Color(0, 0, 0, 45)
		// Omani agent colors - dishdasha (traditional white robe)
		static val DISHDASHA_WHITE = new Color(255, 255, 255)  // White dishdasha
		static val DISHDASHA_SHADOW = new Color(240, 240, 240)  // Light shadow on robe
		static val DISHDASHA_FOLD = new Color(230, 230, 230)  // Fold lines
		static val AGENT_SKIN = new Color(210, 180, 140)  // Skin tone
		static val AGENT_OUTLINE = new Color(50, 50, 50)  // Dark outline
		static val KUMMA_COLOR = new Color(200, 200, 200)  // Kumma (traditional cap) - light gray
		static val KUMMA_BAND = new Color(100, 100, 100)  // Band on kumma

		var objects : Map<Point2i, sokobanObject>
		var time = new AtomicInteger
		
		// Store planned paths for visualization (box position -> path)
		var plannedPaths = <Point2i, List<Point2i>>newHashMap

		new {
			// Use light floor color as background instead of black
			this.background = FLOOR_BASE
		}

		var exitPositions : Set<Point2i>
		
		/** Update planned paths for visualization. */
		def updatePlannedPath(boxPosition : Point2i, path : List<Point2i>) {
			synchronized (this.treeLock) {
				if (path !== null && !path.isEmpty) {
					this.plannedPaths.put(boxPosition, path)
				} else {
					this.plannedPaths.remove(boxPosition)
				}
			}
		}
		
		/** Clear all planned paths. */
		def clearPlannedPaths {
			synchronized (this.treeLock) {
				this.plannedPaths.clear
			}
		}
		
		def setObjects(time : int, objects : Map<Point2i, sokobanObject>, exitPositions : Set<Point2i>) {
			synchronized (this.treeLock) {
				this.time.set(time)
				this.objects = objects
				this.exitPositions = exitPositions
				repaint
			}
		}

		def paint(g : Graphics) {
			super.paint(g)

			var px : int
			var py : int
			var g2d = g as Graphics2D
			g2d.setRenderingHint(RenderingHints::KEY_ANTIALIASING, RenderingHints::VALUE_ANTIALIAS_ON)

			var isEvenTime = (this.time.get % 2) == 0

			if (this.objects !== null) {
				// First, draw exit positions as cell properties (underneath objects)
				if (this.exitPositions !== null) {
					for (exitPos : this.exitPositions) {
						px = CELL_WIDTH * exitPos.x
						py = CELL_HEIGHT * exitPos.y
						drawGoal(g2d, px, py, isEvenTime)
					}
				}
				
				// Draw floor for all cells first (replaces black background)
				for (entry : this.objects.entrySet) {
					var pos = entry.key
					px = CELL_WIDTH * pos.x
					py = CELL_HEIGHT * pos.y
					// Draw floor unless there's an exit (exit will be drawn separately)
					if (this.exitPositions === null || !this.exitPositions.contains(pos)) {
						drawFloor(g2d, px, py)
					}
				}
				
				// Draw planned paths (trails) before objects for debugging
				synchronized (this.treeLock) {
					if (this.plannedPaths !== null && !this.plannedPaths.isEmpty) {
						for (entry : this.plannedPaths.entrySet) {
							var path = entry.value
							if (path !== null && !path.isEmpty) {
								drawPathTrail(g2d, path)
							}
						}
					}
				}
				
				// Then draw objects on top
				for (entry : this.objects.entrySet) {
					var pos = entry.key
					var obj = entry.value
					px = CELL_WIDTH * pos.x
					py = CELL_HEIGHT * pos.y
					if (obj instanceof WallObject) {
						drawWall(g2d, px, py)
					} else if (obj instanceof BoxObject) {
						// Draw box with darker color if on target
						var isOnTarget = (obj as BoxObject).isOnTarget
						drawCrate(g2d, px, py, isEvenTime, isOnTarget)
					} else if (obj instanceof sokobanBody) {
						drawWorker(g2d, px, py)
					} else if (obj instanceof GhostBody) {
						drawCrate(g2d, px, py, isEvenTime, false)
					} //else if (obj instanceof PillObject) {
						//drawGoal(g2d, px, py, obj.superPill || isEvenTime)
					//}

				}
			}
		}
		def drawFloor(g2d : Graphics2D, px : int, py : int) {
			g2d.color = FLOOR_BASE
			g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
			var pad = Math::max(1, CELL_WIDTH / 12)
			g2d.color = FLOOR_NOISE1
			g2d.fillRect(px + pad, py + pad, Math::max(1, CELL_WIDTH / 3), Math::max(1, CELL_HEIGHT / 6))
			g2d.color = FLOOR_NOISE2
			g2d.fillRect(px + CELL_WIDTH - pad - Math::max(2, CELL_WIDTH / 4),
				py + CELL_HEIGHT - pad - Math::max(2, CELL_HEIGHT / 7),
				Math::max(2, CELL_WIDTH / 4), Math::max(1, CELL_HEIGHT / 7))
		}

		def drawWall(g2d : Graphics2D, px : int, py : int) {
			// Simple dark gray wall
			g2d.color = WALL_BASE
			g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
			// Subtle edge highlight
			g2d.color = WALL_LIGHT
			g2d.drawLine(px, py, px + CELL_WIDTH - 1, py)
			g2d.drawLine(px, py, px, py + CELL_HEIGHT - 1)
			// Darker edge shadow
			g2d.color = WALL_EDGE
			g2d.drawLine(px, py + CELL_HEIGHT - 1, px + CELL_WIDTH - 1, py + CELL_HEIGHT - 1)
			g2d.drawLine(px + CELL_WIDTH - 1, py, px + CELL_WIDTH - 1, py + CELL_HEIGHT - 1)
		}

		def drawCrate(g2d : Graphics2D, px : int, py : int, glow : boolean, isOnTarget : boolean) {
			// Enhanced box rendering with better shadows and highlights
			var shadowOffset = Math::max(1, CELL_WIDTH / 15)
			g2d.color = new Color(0, 0, 0, 60)  // Softer shadow
			g2d.fillRoundRect(px + shadowOffset, py + shadowOffset,
				CELL_WIDTH - shadowOffset, CELL_HEIGHT - shadowOffset, 6, 6)
			
			var pad = Math::max(2, CELL_WIDTH / 8)
			var w = CELL_WIDTH - 2 * pad
			var h = CELL_HEIGHT - 2 * pad
			
			// Use darker colors if box is on target (exit)
			if (isOnTarget) {
				g2d.color = CRATE_ON_TARGET_BASE
				g2d.fillRoundRect(px + pad, py + pad, w, h, 8, 8)
				g2d.color = CRATE_ON_TARGET_EDGE
				g2d.drawRoundRect(px + pad, py + pad, w, h, 8, 8)
				// Thicker edge for completed boxes
				g2d.drawRoundRect(px + pad - 1, py + pad - 1, w + 2, h + 2, 8, 8)
				g2d.color = CRATE_ON_TARGET_STRAP
			} else {
				g2d.color = CRATE_BASE
				g2d.fillRoundRect(px + pad, py + pad, w, h, 8, 8)
				g2d.color = CRATE_EDGE
				g2d.drawRoundRect(px + pad, py + pad, w, h, 8, 8)
				g2d.color = CRATE_STRAP
			}
			
			// Horizontal straps (wooden crate detail)
			var strap = Math::max(2, CELL_WIDTH / 12)
			g2d.fillRect(px + pad, py + pad + h / 3, w, strap)
			g2d.fillRect(px + pad, py + pad + 2 * h / 3, w, strap)
			
			// Top highlight for 3D effect
			if (glow) {
				g2d.color = new Color(255, 255, 255, 40)
				g2d.drawLine(px + pad + 2, py + pad + 2, px + pad + w - 2, py + pad + 2)
				// Corner highlights
				g2d.drawLine(px + pad + 2, py + pad + 2, px + pad + 2, py + pad + h / 3)
				g2d.drawLine(px + pad + w - 2, py + pad + 2, px + pad + w - 2, py + pad + h / 3)
			}
		}

		def drawWorker(g2d : Graphics2D, px : int, py : int) {
			// Draw Omani agent in dishdasha (traditional white robe)
			var pad = Math::max(2, CELL_WIDTH / 12)
			
			// Shadow under agent
			g2d.color = SHADOW
			g2d.fillOval(px + pad + CELL_WIDTH / 10, py + CELL_HEIGHT - pad - CELL_HEIGHT / 6,
				CELL_WIDTH - 2 * pad - CELL_WIDTH / 6, CELL_HEIGHT / 5)
			
			// Dishdasha (long white robe) - main body
			var robeW = CELL_WIDTH - 2 * pad
			var robeH = (CELL_HEIGHT * 0.65) as int
			var robeX = px + pad
			var robeY = py + CELL_HEIGHT - robeH - pad
			
			// Main robe body (white)
			g2d.color = DISHDASHA_WHITE
			g2d.fillRect(robeX, robeY, robeW, robeH)
			g2d.color = AGENT_OUTLINE
			g2d.drawRect(robeX, robeY, robeW, robeH)
			
			// Vertical fold lines on dishdasha (traditional detail)
			var foldX1 = robeX + robeW / 3
			var foldX2 = robeX + 2 * robeW / 3
			g2d.color = DISHDASHA_FOLD
			g2d.drawLine(foldX1, robeY, foldX1, robeY + robeH)
			g2d.drawLine(foldX2, robeY, foldX2, robeY + robeH)
			
			// Slight shadow on robe for depth
			g2d.color = DISHDASHA_SHADOW
			g2d.fillRect(robeX + 1, robeY + robeH - 3, robeW - 2, 2)
			
			// Head (with kumma - traditional cap)
			var headD = (CELL_WIDTH * 0.4) as int
			var headX = px + (CELL_WIDTH - headD) / 2
			var headY = robeY - headD / 2
			
			// Face
			g2d.color = AGENT_SKIN
			g2d.fillOval(headX, headY, headD, headD)
			g2d.color = AGENT_OUTLINE
			g2d.drawOval(headX, headY, headD, headD)
			
			// Kumma (traditional Omani cap) - circular cap on head
			var kummaD = (headD * 0.7) as int
			var kummaX = headX + (headD - kummaD) / 2
			var kummaY = headY - kummaD / 3
			g2d.color = KUMMA_COLOR
			g2d.fillOval(kummaX, kummaY, kummaD, kummaD)
			g2d.color = AGENT_OUTLINE
			g2d.drawOval(kummaX, kummaY, kummaD, kummaD)
			
			// Band on kumma (decorative detail)
			var bandY = kummaY + kummaD / 3
			g2d.color = KUMMA_BAND
			g2d.fillRect(kummaX + 2, bandY, kummaD - 4, 2)
		}

		def drawGoal(g2d : Graphics2D, px : int, py : int, pulse : boolean) {
			// Draw green square goal tile (door-like shape)
			// Base green tile
			g2d.color = GOAL_BASE
			g2d.fillRect(px, py, CELL_WIDTH, CELL_HEIGHT)
			
			// Dark green border
			var borderWidth = Math::max(2, CELL_WIDTH / 8)
			g2d.color = GOAL_BORDER
			g2d.fillRect(px, py, CELL_WIDTH, borderWidth)  // Top
			g2d.fillRect(px, py + CELL_HEIGHT - borderWidth, CELL_WIDTH, borderWidth)  // Bottom
			g2d.fillRect(px, py, borderWidth, CELL_HEIGHT)  // Left
			g2d.fillRect(px + CELL_WIDTH - borderWidth, py, borderWidth, CELL_HEIGHT)  // Right
			
			// Inner darker green square (door-like effect)
			var innerPad = Math::max(3, CELL_WIDTH / 5)
			g2d.color = GOAL_INNER
			g2d.fillRect(px + innerPad, py + innerPad, 
				CELL_WIDTH - 2 * innerPad, CELL_HEIGHT - 2 * innerPad)
			
			// Light green highlight (pulsing effect)
			if (pulse) {
				var highlightPad = Math::max(2, CELL_WIDTH / 6)
				g2d.color = GOAL_HIGHLIGHT
				g2d.fillRect(px + highlightPad, py + highlightPad,
					CELL_WIDTH - 2 * highlightPad, CELL_HEIGHT - 2 * highlightPad)
			}
			
			// Center dot/indicator
			var dotSize = Math::max(3, CELL_WIDTH / 6)
			g2d.color = GOAL_BORDER
			g2d.fillOval(px + (CELL_WIDTH - dotSize) / 2, py + (CELL_HEIGHT - dotSize) / 2, 
				dotSize, dotSize)
		}
		
		/** Draw path trail for debugging - shows the planned path from box to exit. */
		def drawPathTrail(g2d : Graphics2D, path : List<Point2i>) {
			if (path === null || path.isEmpty) {
				return
			}
			
			// Path trail color - semi-transparent blue
			var pathColor = new Color(100, 150, 255, 120)  // Light blue with transparency
			var pathLineColor = new Color(50, 100, 200, 180)  // Darker blue for lines
			var startColor = new Color(0, 255, 0, 150)  // Green for start (box)
			var endColor = new Color(255, 0, 0, 150)  // Red for end (exit)
			
			g2d.stroke = new java.awt.BasicStroke(2.0f)
			
			// Draw path segments (lines between consecutive points)
			for (i : 0 ..< path.size - 1) {
				var from = path.get(i)
				var to = path.get(i + 1)
				
				var fromX = CELL_WIDTH * from.x + DEMI_CELL_WIDTH
				var fromY = CELL_HEIGHT * from.y + DEMI_CELL_HEIGHT
				var toX = CELL_WIDTH * to.x + DEMI_CELL_WIDTH
				var toY = CELL_HEIGHT * to.y + DEMI_CELL_HEIGHT
				
				// Draw line
				g2d.color = pathLineColor
				g2d.drawLine(fromX, fromY, toX, toY)
			}
			
			// Draw path nodes (circles at each point)
			for (i : 0 ..< path.size) {
				var point = path.get(i)
				var centerX = CELL_WIDTH * point.x + DEMI_CELL_WIDTH
				var centerY = CELL_HEIGHT * point.y + DEMI_CELL_HEIGHT
				var nodeSize = Math::max(4, CELL_WIDTH / 5)
				
				if (i == 0) {
					// Start point (box position) - green circle
					g2d.color = startColor
					g2d.fillOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
					g2d.color = new Color(0, 200, 0, 200)
					g2d.drawOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
				} else if (i == path.size - 1) {
					// End point (exit) - red circle
					g2d.color = endColor
					g2d.fillOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
					g2d.color = new Color(200, 0, 0, 200)
					g2d.drawOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
				} else {
					// Intermediate points - blue circles
					g2d.color = pathColor
					g2d.fillOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
					g2d.color = pathLineColor
					g2d.drawOval(centerX - nodeSize / 2, centerY - nodeSize / 2, nodeSize, nodeSize)
				}
			}
		}

	}

}
