import sokoban.environment.^agent.DefaultMazeMotionSkill
import sokoban.environment.^agent.MazeMotion
import sokoban.environment.^agent.sokobanIsDead
import sokoban.environment.^agent.Perception
import sokoban.environment.maze.Direction
import sokoban.environment.maze.sokobanBody
import io.sarl.api.core.Initialize
import io.sarl.api.core.Lifecycle
import java.util.List
import java.util.Random
import sokoban.environment.maze.sokobanObject
import java.util.ArrayList

/** Ghost.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
agent Ghost {

	uses MazeMotion, Lifecycle

	val random = new Random

	var previousDirection : Direction

	on sokobanIsDead {
		killMe
	}

	on Perception {

		// Find sokoban
		var sokoban : sokobanBody = null
		for (o : occurrence.objects) {
			if (o instanceof sokobanBody) {
				sokoban = (o as sokobanBody)
				break
			}
		}

		var dir : Direction = null
		val myPos = occurrence.position

		if (sokoban !== null) {
			// sokoban currently super power?
			var sokobanHasSuperPower = false

			sokobanHasSuperPower = sokoban.isSupersokoban()

			val px = sokoban.position.x
			val py = sokoban.position.y
			val dx = px - myPos.x
			val dy = py - myPos.y

			if (!sokobanHasSuperPower) {
				// PURSUE: move toward sokoban
				if (dy == 0 && dx != 0) {
					dir = (dx > 0) ? Direction::EAST : Direction::WEST
				} else if (dx == 0 && dy != 0) {
					dir = (dy > 0) ? Direction::SOUTH : Direction::NORTH
				} else {
					if (Math::abs(dx) >= Math::abs(dy)) {
						dir = (dx > 0) ? Direction::EAST : Direction::WEST
					} else {
						dir = (dy > 0) ? Direction::SOUTH : Direction::NORTH
					}
				}
			} else {
				// EVADE: move away from sokoban
				if (dy == 0 && dx != 0) {
					dir = (dx > 0) ? Direction::WEST : Direction::EAST
				} else if (dx == 0 && dy != 0) {
					dir = (dy > 0) ? Direction::NORTH : Direction::SOUTH
				} else {
					if (Math::abs(dx) >= Math::abs(dy)) {
						dir = (dx > 0) ? Direction::WEST : Direction::EAST
					} else {
						dir = (dy > 0) ? Direction::NORTH : Direction::SOUTH
					}
				}
			}
		} else {
			// No target in sight: random patrol avoide U-turns
			val all = #[Direction::NORTH, Direction::EAST, Direction::SOUTH, Direction::WEST]
			var choices = new ArrayList<Direction>
			for (d : all) {
				if (previousDirection === null) {
					choices += d
				} else {
					switch (previousDirection) {
						case Direction::NORTH: if(d != Direction::SOUTH) choices += d
						case Direction::SOUTH: if(d != Direction::NORTH) choices += d
						case Direction::EAST: if(d != Direction::WEST) choices += d
						case Direction::WEST: if(d != Direction::EAST) choices += d
						default: choices += d
					}
				}
			}

			val r = new Random
			dir = choices.get(r.nextInt(choices.size))
		}

		if (dir !== null) {
			previousDirection = dir
			move(dir)

		}
	}

}
