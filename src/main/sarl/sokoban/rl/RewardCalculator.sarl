/* 
 * Reward calculation for RL Sokoban environment.
 * 
 * Computes rewards based on state changes and game events.
 */
package sokoban.rl

import java.util.ArrayList
import java.util.List
import org.eclipse.xtext.xbase.lib.Pure
import framework.math.Point2i

/**
 * Reward calculator for Sokoban RL environment.
 * 
 * Computes rewards based on:
 * - State changes (boxes moved onto/off targets)
 * - Action validity
 * - Terminal conditions
 * - Per-step penalties
 */
class RewardCalculator {

	/** Reward when a box is moved onto a target cell. */
	static val REWARD_BOX_ON_TARGET = 10.0

	/** Per-step penalty to encourage efficiency. */
	static val PENALTY_PER_STEP = -0.1

	/** Penalty for invalid moves (wall collision, boundary violation). */
	static val PENALTY_INVALID_MOVE = -1.0

	/** Terminal reward when all boxes are on targets. */
	static val REWARD_ALL_BOXES_ON_TARGETS = 100.0

	/** Penalty when a box is pushed off a target cell. */
	static val PENALTY_BOX_OFF_TARGET = -0.5

	/** Compute reward based on state changes.
	 * 
	 * @param prevState previous state (before action)
	 * @param newState new state (after action)
	 * @param actionValid whether the action was valid (not blocked)
	 * @return computed reward
	 */
	@Pure
	static def computeReward(
		prevState : SokobanState,
		newState : SokobanState,
		actionValid : boolean
	) : double {
		var reward = 0.0

		// Penalty for invalid moves
		if (!actionValid) {
			reward += PENALTY_INVALID_MOVE
			return reward
		}

		// Per-step penalty (encourage efficiency)
		reward += PENALTY_PER_STEP

		// Check for boxes moved onto targets
		var boxesOnTargetBefore = countBoxesOnTargets(prevState)
		var boxesOnTargetAfter = countBoxesOnTargets(newState)
		
		if (boxesOnTargetAfter > boxesOnTargetBefore) {
			// Box(es) moved onto target(s)
			var boxesGained = boxesOnTargetAfter - boxesOnTargetBefore
			reward += boxesGained * REWARD_BOX_ON_TARGET
		} else if (boxesOnTargetAfter < boxesOnTargetBefore) {
			// Box(es) moved off target(s)
			var boxesLost = boxesOnTargetBefore - boxesOnTargetAfter
			reward += boxesLost * PENALTY_BOX_OFF_TARGET
		}

		// Terminal reward (all boxes on targets)
		if (newState.allBoxesOnTargets) {
			reward += REWARD_ALL_BOXES_ON_TARGETS
		}

		return reward
	}

	/** Compute reward for terminal state.
	 * 
	 * @param state terminal state
	 * @return terminal reward
	 */
	@Pure
	static def computeTerminalReward(state : SokobanState) : double {
		if (state.allBoxesOnTargets) {
			return REWARD_ALL_BOXES_ON_TARGETS
		}
		return 0.0
	}

	/** Count how many boxes are on target cells.
	 * 
	 * @param state the state to check
	 * @return number of boxes on targets
	 */
	@Pure
	static def countBoxesOnTargets(state : SokobanState) : int {
		var count = 0
		var onTargetFlags = state.boxOnTargetFlags
		for (onTarget : onTargetFlags) {
			if (onTarget) {
				count++
			}
		}
		return count
	}

	/** Check if a box moved from one position to another.
	 * 
	 * @param prevState previous state
	 * @param newState new state
	 * @return list of box indices that moved, empty if no boxes moved
	 */
	@Pure
	static def getMovedBoxes(
		prevState : SokobanState,
		newState : SokobanState
	) : List<Integer> {
		var movedBoxes = new ArrayList<Integer>
		var prevBoxPositions = prevState.boxPositions
		var newBoxPositions = newState.boxPositions
		
		if (prevBoxPositions.size != newBoxPositions.size) {
			// Different number of boxes - shouldn't happen, but handle gracefully
			return movedBoxes
		}
		
		for (var i = 0; i < prevBoxPositions.size; i++) {
			var prevPos = prevBoxPositions.get(i)
			var newPos = newBoxPositions.get(i)
			if (!prevPos.equals(newPos)) {
				movedBoxes += i
			}
		}
		
		return movedBoxes
	}

	/** Check if a specific box moved onto a target.
	 * 
	 * @param prevState previous state
	 * @param newState new state
	 * @param boxIndex index of the box to check
	 * @return true if box moved onto target
	 */
	@Pure
	static def boxMovedOntoTarget(
		prevState : SokobanState,
		newState : SokobanState,
		boxIndex : int
	) : boolean {
		if (boxIndex < 0 || boxIndex >= prevState.boxOnTargetFlags.size) {
			return false
		}
		
		var wasOnTarget = prevState.boxOnTargetFlags.get(boxIndex)
		var isOnTarget = newState.boxOnTargetFlags.get(boxIndex)
		
		return !wasOnTarget && isOnTarget
	}

	/** Check if a specific box moved off a target.
	 * 
	 * @param prevState previous state
	 * @param newState new state
	 * @param boxIndex index of the box to check
	 * @return true if box moved off target
	 */
	@Pure
	static def boxMovedOffTarget(
		prevState : SokobanState,
		newState : SokobanState,
		boxIndex : int
	) : boolean {
		if (boxIndex < 0 || boxIndex >= prevState.boxOnTargetFlags.size) {
			return false
		}
		
		var wasOnTarget = prevState.boxOnTargetFlags.get(boxIndex)
		var isOnTarget = newState.boxOnTargetFlags.get(boxIndex)
		
		return wasOnTarget && !isOnTarget
	}

}






