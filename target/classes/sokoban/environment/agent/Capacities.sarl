/** Capacity to manage a maze.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
capacity MazeManager {
	
	/** Replies the number of bodies in the maze */
	def getBodyCount : int
	
	/** Apply the list of actions.
	 * @return true if the sokoban is dead. */
	def applyActions(actions : List<MazeChangeQuery>) : boolean
	
	/** Replies the perceptions. */
	def getPerceptions : Map<AgentBody, List<sokobanObject>>
	
	/** Replies the width of the maze. */
	def getMazeWidth : int

	/** Replies the height of the maze. */
	def getMazeHeight : int
	
	/** Replies all the objects. */
	def getsokobanObjects : List<sokobanObject>

	/** Replies a specific body. */
	def getAgentBody(id : UUID) : AgentBody
	
	/** Replies super power accessor. */
	def getSuperPowerAccessor(id : UUID) : SuperPowerAccessor

	/** Create a ghost body. */
	def createGhost(perceptionDistance : int) : GhostBody

	/** Create a sokoban body. */
	def createsokoban() : sokobanBody

	/** Create a box at the given position. */
	def createBox(x : int, y : int) : boolean

	/** Create boxes randomly in the maze. */
	def createBoxes(numberOfBoxes : int) : void

	/** Create an exit at the given position. */
	def createExit(x : int, y : int) : boolean

	/** Create exits randomly in the maze. */
	def createExits(numberOfExits : int) : void

	/** Check if all agents have reached exits.
	 * 
	 * Only counts sokobanBody instances (autonomous SokobanAgent), 
	 * excludes GhostBody.
	 * 
	 * All agents are autonomous (project requirement).
	 * 
	 * @return true if all agents are at exit positions
	 */
	def allAgentsAtExit : boolean

	/** Check if all boxes are placed on goal cells (exits).
	 * This is the correct win condition for Sokoban.
	 * 
	 * @return true if all boxes are on goals
	 */
	def allBoxesOnGoals : boolean

	/** Get all exit positions. */
	def getExitPositions : List<Point2i>

	/** Extract SokobanState from current maze state for RL.
	 * 
	 * @param stepCount current step count
	 * @return SokobanState representation of current state
	 */
	def extractSokobanState(stepCount : int) : SokobanState

	/** Execute a player movement action directly (for RL).
	 * 
	 * @param direction the direction to move
	 * @return true if action was valid and executed
	 */
	def executePlayerAction(direction : Direction) : boolean

	/** Count boxes currently on target cells (exits).
	 * 
	 * @return number of boxes on targets
	 */
	def countBoxesOnTargets : int

	/** Count agents currently at exit positions.
	 * 
	 * @return number of agents at exits
	 */
	def countAgentsAtExit : int

	/** Get total number of boxes in the maze.
	 * 
	 * @return total number of boxes
	 */
	def getTotalBoxCount : int

}

/** Capacity to be the front-end for the maze.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
capacity MazeFrontEnd {
	
	def sendPerception(time : int, bodyID : UUID, objects : List<sokobanObject>, position : Point2i)

}

/** Capacity to move in the maze.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
@DefaultSkill(typeof(DefaultMazeMotionSkill))
capacity MazeMotion {
	
	def move(direction : Direction)

}


skill DefaultMazeManagerSkill implements MazeManager {
	
	val random = new Random
	
	val width : int
	val height : int
	
	var maze : Maze
	
	new (width : int, height : int) {
		this.width = width
		this.height = height
	}
	
	def install {
		this.maze = new Maze(this.width, this.height)
	}
	
	def uninstall {
		this.maze = null
	}
	
	def getBodyCount : int {
		this.maze.bodyCount
	}

	def applyActions(actions : List<MazeChangeQuery>) : boolean {

		var lastActions = new TreeMap<UUID, Direction>
		for (action : actions) {
			lastActions.put(action.emitter, action.change)
		}

		var sokobanDead = false

		val objects = getsokobanObjects
		var sokoban : sokobanBody = null
		val ghosts = new ArrayList<GhostBody>
		for (o : objects) {
			if (o instanceof sokobanBody) {
				sokoban = (o as sokobanBody)
			} else if (o instanceof GhostBody) {
				ghosts += (o as GhostBody)
			}
		}

		// Apply moves for each body that emitted an action
		for (entry : lastActions.entrySet) {
			val body = getAgentBody(entry.key)
			if (body !== null) {
				// Check if this is the player (sokoban body)
				if (body instanceof sokobanBody) {
					// Use Sokoban movement rules with box pushing
					var dx = 0
					var dy = 0
					switch (entry.value) {
						case Direction::NORTH: dy = -1
						case Direction::SOUTH: dy = 1
						case Direction::WEST: dx = -1
						case Direction::EAST: dx = 1
						default: {
						}
					}
					// Use the maze's movePlayer method which handles box pushing
					maze.movePlayer(body, dx, dy)
				} else {
					// For other bodies (ghosts), use simple movement
					val pos = body.position
					var nx = pos.x
					var ny = pos.y
					switch (entry.value) {
						case Direction::NORTH: ny--
						case Direction::SOUTH: ny++
						case Direction::WEST: nx--
						case Direction::EAST: nx++
						default: {
						}
					}
					// Check bounds and walkability for ghosts
					if (nx >= 0 && ny >= 0 && nx < this.width && ny < this.height) {
						if (maze.isWalkable(nx, ny)) {
							maze.setObjectAt(nx, ny, body)
						}
					}
				}
			}
		}

		// Collision with ghosts
		if (sokoban !== null) {
			for (g : ghosts) {
				if (g.position.equals(sokoban.position)) {
					sokobanDead = true
					break
				}
			}
		}

		return sokobanDead
}
	
	def in(v : int, r : IntegerRange) : boolean {
		r.contains(v)
	}

	// My Helpers
	def isInside(x : int, y : int) : boolean {
		return (x >= 0 && y >= 0 && x < this.width && y < this.height)
	}

	def cellIsOccluder(x : int, y : int) : boolean {
		var cellContent = this.maze.getObjectAt(x, y)
		if (cellContent === null) {
			return false  // Empty cells are not occluders
		}
		return cellContent.isOccluder
	}
	
	/** Check if there's a clear line-of-sight between two points using Bresenham's line algorithm.
	 * Returns true if the path is clear (no occluders blocking the view).
	 */
	def hasLineOfSight(x1 : int, y1 : int, x2 : int, y2 : int) : boolean {
		// If same point, no line-of-sight needed
		if (x1 == x2 && y1 == y2) {
			return true
		}
		
		var dx = Math::abs(x2 - x1)
		var dy = Math::abs(y2 - y1)
		var sx = if (x1 < x2) 1 else -1
		var sy = if (y1 < y2) 1 else -1
		var err = dx - dy
		
		var x = x1
		var y = y1
		var maxSteps = dx + dy + 1  // Safety limit to prevent infinite loops
		var steps = 0
		
		// Traverse the line, checking intermediate cells for occluders
		// Don't check the starting cell (agent position) or the target cell (object position)
		while (steps < maxSteps) {
			// Check if we've reached the target (don't check the target cell itself)
			if (x == x2 && y == y2) {
				return true  // Reached target, path is clear
			}
			
			// Check intermediate cells for occluders (skip starting position)
			if (!(x == x1 && y == y1)) {
				if (!isInside(x, y) || cellIsOccluder(x, y)) {
					return false  // Path blocked
				}
			}
			
			// Move to next cell using Bresenham's algorithm
			var e2 = 2 * err
			if (e2 > -dy) {
				err -= dy
				x += sx
			}
			if (e2 < dx) {
				err += dx
				y += sy
			}
			
			steps++
		}
		
		// If we didn't reach the target, path is blocked
		return false
	}
	
	def getPerceptions : Map<AgentBody, List<sokobanObject>> {
		var perceptions = new TreeMap
		
		// Get all agent bodies from the maze
		var bodies = this.maze.getAgentBodies
		if(bodies === null || bodies.isEmpty){
			System.out.println("[MazeManager] No agent bodies found for perception")
			return perceptions
		}
		System.out.println("[MazeManager] Getting perceptions for " + bodies.size + " agent body/bodies")
		
		// Collect all objects from the maze grid (boxes, exits, walls, other agents)
		var allObjects = new ArrayList<sokobanObject>
		var boxCount = 0
		
		// Iterate through the entire grid to find all objects
		for (var x = 0; x < this.width; x++) {
			for (var y = 0; y < this.height; y++) {
				var obj = this.maze.getObjectAt(x, y)
				if (obj !== null) {
					allObjects += obj
					if (obj instanceof BoxObject) {
						boxCount++
					}
				}
			}
		}
		System.out.println("[MazeManager] Total objects in maze: " + allObjects.size + " (including " + boxCount + " boxes)")
		
		// I implemented an algorithm to see which objects are within distance d and one direction (and no walls in between)
		// Like a "Line of Sight"
		
		// P.S: I purposely did not use the method shown in lecture. 
		// The algorithm from the lecture is for sure more efficient but I wanted to do better than copy paste! :)
		for(b : bodies){
			var seen = new ArrayList<sokobanObject>
			var bp = b.position
			var d = b.perceptionDistance
			
			if(d > 0){
				// Check all objects (boxes, exits, walls, other agents)
				for (o: allObjects){
					if (o !== b){
						val op = o.position
						val dx = op.x - bp.x
						val dy = op.y - bp.y
						val manhattanDist = Math::abs(dx) + Math::abs(dy)
						
						// Check if object is within perception distance (Manhattan distance)
						if (manhattanDist <= d && manhattanDist > 0) {
							// Use Bresenham's line algorithm to check line-of-sight
							var visible = hasLineOfSight(bp.x, bp.y, op.x, op.y)
							
							if(visible){
								seen += o
								if (o instanceof BoxObject) {
									System.out.println("[MazeManager] Agent at (" + bp.x + ";" + bp.y + ") sees BoxObject at (" + op.x + ";" + op.y + ")")
								}
							}
						}
					}
				}
			}
			
			var seenBoxes = 0
			for (obj : seen) {
				if (obj instanceof BoxObject) {
					seenBoxes++
				}
			}
			if (seenBoxes > 0) {
				System.out.println("[MazeManager] Agent at (" + b.position.x + ";" + b.position.y + ") sees " + seenBoxes + " box(es) out of " + seen.size + " objects")
			}
			
			perceptions.put(b, seen)
			System.out.println("[MazeManager] Agent at (" + bp.x + ";" + bp.y + ") sees " + seen.size + " object(s)")
		}
		
		
		return perceptions
	}
	
	
	
	
	
	
	def getMazeHeight : int {
		this.height
	}
	
	def getMazeWidth : int {
		this.width
	}
	
	def getsokobanObjects : List<sokobanObject> {
		var list = newArrayList
		for (i : 0..<this.width) {
			for (j : 0..<this.height) {
				var o = this.maze.getObjectAt(i, j)
				if (o !== null) {
					list += o
				}
			}
		}
		return list
	}
	
	def getAgentBody(id : UUID) : AgentBody {
		this.maze.getAgentBody(id)
	}

	def getSuperPowerAccessor(id : UUID) : SuperPowerAccessor {
		this.maze.getSuperPowerAccessorFor(id)
	}

	def createGhost(perceptionDistance : int) : GhostBody {
		this.maze.createBody(typeof(GhostBody), null, perceptionDistance);
	}
	
	def createsokoban : sokobanBody {
		this.maze.createBody(typeof(sokobanBody), null, 5);
	}

	def createBox(x : int, y : int) : boolean {
		if (this.maze.inBounds(x, y) && this.maze.isWalkable(x, y)) {
			var obj = this.maze.getObjectAt(x, y)
			if (obj === null || obj.pickable) {
				var box = new BoxObject(x, y, this.maze)
				this.maze.setObjectAt(x, y, box)
				// onTarget status is automatically set in BoxObject constructor
				return true
			}
		}
		return false
	}

	def createBoxes(numberOfBoxes : int) : void {
		// Place boxes in simple, predefined positions (Sokoban-style)
		// Place boxes in the left side of the room
		var boxesCreated = 0
		var startX = Math::max(2, this.width / 4)
		var startY = Math::max(2, this.height / 3)
		
		System.out.println("[MazeManager] Creating " + numberOfBoxes + " boxes, maze size: " + this.width + "x" + this.height)
		
		// Create a simple grid of boxes
		var boxesPerRow = Math::min(3, numberOfBoxes)
		var rows = (numberOfBoxes + boxesPerRow - 1) / boxesPerRow
		
		for (var row = 0; row < rows && boxesCreated < numberOfBoxes; row++) {
			for (var col = 0; col < boxesPerRow && boxesCreated < numberOfBoxes; col++) {
				var x = startX + col * 2
				var y = startY + row * 2
				
				if (x < this.width - 2 && y < this.height - 2) {
					if (createBox(x, y)) {
						boxesCreated++
						System.out.println("[MazeManager] Created box #" + boxesCreated + " at (" + x + ";" + y + ")")
					}
				}
			}
		}
		
		// If we still need more boxes, place them randomly
		var attempts = 0
		val maxAttempts = 500
		while (boxesCreated < numberOfBoxes && attempts < maxAttempts) {
			attempts++
			var x = this.random.nextInt(this.width - 2) + 1
			var y = this.random.nextInt(this.height - 2) + 1
			
			if (createBox(x, y)) {
				boxesCreated++
			}
		}
	}

	def createExit(x : int, y : int) : boolean {
		if (this.maze.inBounds(x, y) && this.maze.isWalkable(x, y)) {
			// Exits are now cell properties, not objects
			// They can be placed on any walkable cell (boxes can be placed on them)
			return this.maze.addExit(x, y)
		}
		return false
	}

	def createExits(numberOfExits : int) : void {
		// Place exits in simple, predefined positions (Sokoban-style)
		// Place exits on the right side of the room (opposite from boxes)
		var exitsCreated = 0
		var startX = Math::max(this.width - 4, this.width * 3 / 4)
		var startY = Math::max(2, this.height / 3)
		
		// Create a simple grid of exits matching box layout
		var exitsPerRow = Math::min(3, numberOfExits)
		var rows = (numberOfExits + exitsPerRow - 1) / exitsPerRow
		
		for (var row = 0; row < rows && exitsCreated < numberOfExits; row++) {
			for (var col = 0; col < exitsPerRow && exitsCreated < numberOfExits; col++) {
				var x = startX - col * 2
				var y = startY + row * 2
				
				if (x > 1 && x < this.width - 1 && y > 1 && y < this.height - 1) {
					if (createExit(x, y)) {
						exitsCreated++
					}
				}
			}
		}
		
		// If we still need more exits, place them randomly
		var attempts = 0
		val maxAttempts = 500
		while (exitsCreated < numberOfExits && attempts < maxAttempts) {
			attempts++
			var x = this.random.nextInt(this.width - 2) + 1
			var y = this.random.nextInt(this.height - 2) + 1
			
			if (createExit(x, y)) {
				exitsCreated++
			}
		}
	}

	def allAgentsAtExit : boolean {
		val exits = this.maze.getExits
		if (exits.isEmpty) {
			return false
		}
		
		val agentBodies = this.maze.getAgentBodies
		if (agentBodies.isEmpty) {
			return false
		}
		
		// Get all agent bodies (sokobanBody instances, excluding GhostBody)
		// All agents are autonomous (project requirement)
		var agentBodiesToCheck = new ArrayList<AgentBody>
		for (body : agentBodies) {
			// Only count sokobanBody (autonomous SokobanAgent), exclude GhostBody
			if (body instanceof sokobanBody) {
				agentBodiesToCheck.add(body)
			}
		}
		
		if (agentBodiesToCheck.isEmpty) {
			return false
		}
		
		// Check if all agents are at an exit position
		for (body : agentBodiesToCheck) {
			var agentPos = body.position
			var atExit = false
			for (exitPos : exits) {
				if (agentPos.equals(exitPos)) {
					atExit = true
					break
				}
			}
			if (!atExit) {
				return false
			}
		}
		return true
	}

	def allBoxesOnGoals : boolean {
		val boxes = this.maze.getAllBoxes
		if (boxes.isEmpty) {
			return false
		}
		
		// Check if all boxes are on goal cells (exits)
		for (box : boxes) {
			if (!box.isOnTarget) {
				return false
			}
		}
		
		return true
	}

	def getExitPositions : List<Point2i> {
		this.maze.getExits
	}

	def extractSokobanState(stepCount : int) : SokobanState {
		// Extract agent position (find sokobanBody)
		var agentPosition : Point2i = null
		var agentBodies = this.maze.getAgentBodies
		for (body : agentBodies) {
			if (body instanceof sokobanBody) {
				agentPosition = body.position
				break
			}
		}
		
		// Default to (0,0) if no agent found
		if (agentPosition === null) {
			agentPosition = new Point2i(0, 0)
		}
		
		// Extract box positions and onTarget flags
		var boxPositions = new ArrayList<Point2i>
		var boxOnTargetFlags = new ArrayList<boolean>
		var allObjects = getsokobanObjects
		for (obj : allObjects) {
			if (obj instanceof BoxObject) {
				var box = obj as BoxObject
				boxPositions += box.position
				boxOnTargetFlags += box.isOnTarget
			}
		}
		
		// Extract wall grid (convert to boolean[][])
		var wallGrid = Array::newInstance(typeof(boolean[]), this.width) as boolean[][]
		for (var x = 0; x < this.width; x++) {
			wallGrid.set(x, Array::newInstance(typeof(boolean), this.height) as boolean[])
			for (var y = 0; y < this.height; y++) {
				var obj = this.maze.getObjectAt(x, y)
				wallGrid.get(x).set(y, obj instanceof WallObject)
			}
		}
		
		// Extract target positions
		var targetPositions = getExitPositions
		
		// Create and return SokobanState
		return new SokobanState(
			agentPosition,
			boxPositions,
			boxOnTargetFlags,
			wallGrid,
			targetPositions,
			stepCount,
			this.width,
			this.height
		)
	}

	def executePlayerAction(direction : Direction) : boolean {
		// Get player body (sokobanBody)
		var agentBodies = this.maze.getAgentBodies
		var playerBody : sokobanBody = null
		
		for (body : agentBodies) {
			if (body instanceof sokobanBody) {
				playerBody = body
				break
			}
		}
		
		if (playerBody === null) {
			return false
		}
		
		// Convert Direction to dx, dy
		var dx = 0
		var dy = 0
		switch (direction) {
			case Direction::NORTH: {
				dy = -1
			}
			case Direction::SOUTH: {
				dy = 1
			}
			case Direction::EAST: {
				dx = 1
			}
			case Direction::WEST: {
				dx = -1
			}
			default: {
				return false
			}
		}
		
		// Execute movement through maze
		return this.maze.movePlayer(playerBody, dx, dy)
	}

	def countBoxesOnTargets : int {
		var count = 0
		val exits = this.maze.getExits
		if (exits.isEmpty) {
			return 0
		}
		for (i : 0..<this.width) {
			for (j : 0..<this.height) {
				var obj = this.maze.getObjectAt(i, j)
				if (obj instanceof BoxObject) {
					var boxPos = obj.position
					for (exitPos : exits) {
						if (boxPos.equals(exitPos)) {
							count++
							break
						}
					}
				}
			}
		}
		return count
	}

	def countAgentsAtExit : int {
		var count = 0
		val exits = this.maze.getExits
		if (exits.isEmpty) {
			return 0
		}
		val agentBodies = this.maze.getAgentBodies
		for (body : agentBodies) {
			var agentPos = body.position
			for (exitPos : exits) {
				if (agentPos.equals(exitPos)) {
					count++
					break
				}
			}
		}
		return count
	}

	def getTotalBoxCount : int {
		var count = 0
		for (i : 0..<this.width) {
			for (j : 0..<this.height) {
				var obj = this.maze.getObjectAt(i, j)
				if (obj instanceof BoxObject) {
					count++
				}
			}
		}
		return count
	}
	
}

/** Skill for being the front-end of a maze.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
skill DefaultMazeFrontEndSkill implements MazeFrontEnd {
	
	uses DefaultContextInteractions, Behaviors
	
	var mazeSpace : MazeSpace
	
	def install {
		var spaceId = MazeSpaceUtils.getSpaceIDInContext(defaultContext)
		this.mazeSpace = defaultContext.getOrCreateSpaceWithSpec(typeof(MazeSpaceSpecification), spaceId,
			defaultSpace, asEventListener)
	}
	
	def sendPerception(time : int, bodyID : UUID, objects : List<sokobanObject>, position : Point2i) {
		var p = new Perception(time, bodyID, objects, position)
		this.mazeSpace.notifyPerception(owner.ID, p)
	}
	
}

/** Default implementation of the MazeMotion capacity.
 * 
 * @author $Author: sgalland$
 * @version $FullVersion$
 * @mavengroupid $GroupId$
 * @mavenartifactid $ArtifactId$
 */
skill DefaultMazeMotionSkill implements MazeMotion {
	
	uses DefaultContextInteractions, Behaviors
	
	var ^space : MazeSpace
	
	var binder : SkillBinder
	
	def install {
		var dc = defaultContext
		var spaceId = MazeSpaceUtils::getSpaceIDInContext(dc)
		this.^space = dc.getSpace(spaceId)
		while (^space === null) {
			// wait for the creation of the space
		}
		this.binder = new SkillBinder(asEventListener, owner.ID)
		this.^space.spawnBody(this.binder)
	}
	
	def uninstall {
		this.^space.killBody(this.binder)
	}
	
	def move(direction : Direction) {
		this.^space.influence(this.binder.currentTime, this.binder.ID, direction)
	}

}
